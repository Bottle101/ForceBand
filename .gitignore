# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.DS_Store

# ── Run outputs ──────────────────────────────────────────────────────────
# Everything under results/ is generated by evaluate.py except the committed
# reference metrics.
lightning_logs/
results/*
!results/reference/

# ── DINOv3: held back (custom, non-Apache license) ───────────────────────
# The release ships only the Apache-2.0 DINOv2 checkpoint (see README roadmap).
# The DINOv3 checkpoint is kept locally but not part of this release.
checkpoints/emg2force_prevforce.ckpt

# ── Large media: not committed — fetch with scripts/download_videos.py ────
# RGB overlay videos (~1.3 GB) are distributed separately via Google Drive.
data/videos/

# ── Pretraining data: under preparation ──────────────────────────────────
# Only a small held-out validation subset ships (data/val/idx_*.h5). The bulk
# pretraining chunks and the legacy (Oct–Nov) robot sessions are kept locally
# but are not part of this release.
data/train/
data/val/task_*
data/splits/train.txt
data/emg_rgb_pairing.json

# Long-form README backup (references the held-back DINOv3) — local only.
docs/README_full.md
